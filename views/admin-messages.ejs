<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages — Pulsewire Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('partials/admin-navbar', { page: 'messages' }) %>

  <main class="admin-main">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Messages</h1>
        <p class="admin-page-sub">Visitor chat threads</p>
      </div>
    </div>

    <% if (chats.length === 0) { %>
      <div class="panel empty-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <p>No messages yet. Visitor chats will appear here.</p>
      </div>
    <% } else { %>
      <div class="chat-threads">
        <% chats.forEach(chat => { %>
          <div class="panel chat-thread">
            <div class="chat-thread-header">
              <div class="chat-avatar"><%= chat.name.charAt(0).toUpperCase() %></div>
              <div>
                <strong class="chat-name"><%= chat.name %></strong>
                <span class="chat-meta"><%= chat.messages.length %> message<%= chat.messages.length !== 1 ? 's' : '' %></span>
              </div>
            </div>
            <div class="chat-messages">
              <% chat.messages.forEach(m => { %>
                <div class="chat-bubble <%= m.from === 'admin' ? 'bubble-admin' : 'bubble-user' %>">
                  <span class="bubble-sender"><%= m.from === 'admin' ? 'You' : chat.name %></span>
                  <p class="bubble-text"><%= m.text %></p>
                </div>
              <% }) %>
            </div>
            <form method="POST" action="/admin/chat/reply/<%= chat.id %>" class="reply-form">
              <input type="text" name="message" placeholder="Type a reply..." required>
              <button type="submit" class="btn btn-primary btn-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Send
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
