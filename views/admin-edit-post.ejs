<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post — Pulsewire Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('partials/admin-navbar', { page: 'dashboard' }) %>

  <main class="admin-main">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Edit Post</h1>
        <p class="admin-page-sub">Update content and media</p>
      </div>
      <div style="display:flex;gap:10px;">
        <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-live">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          View Live
        </a>
        <a href="/admin/dashboard" class="btn btn-dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back
        </a>
      </div>
    </div>

    <div class="panel">
      <form method="POST" action="/admin/edit-post/<%= post.slug %>" class="post-form" enctype="multipart/form-data" id="editForm">
        <div class="form-row">
          <div class="form-group grow">
            <label>Title</label>
            <input type="text" name="title" value="<%= post.title %>" required>
          </div>
          <div class="form-group">
            <label>Category</label>
            <select name="category">
              <option <%= post.category === 'NEWS'          ? 'selected' : '' %>>NEWS</option>
              <option <%= post.category === 'ENTERTAINMENT' ? 'selected' : '' %>>ENTERTAINMENT</option>
              <option <%= post.category === 'CULTURE'       ? 'selected' : '' %>>CULTURE</option>
              <option <%= post.category === 'TRENDING'      ? 'selected' : '' %>>TRENDING</option>
            </select>
          </div>
        </div>

        <!-- Cover image -->
        <div class="form-group">
          <label>Cover Image</label>
          <div class="upload-area" id="uploadArea">
            <input type="file" name="coverImage" id="coverImageInput" accept="image/*">
            <% if (post.coverImage) { %>
              <img src="<%= post.coverImage %>" class="cover-preview" id="coverPreview" alt="current cover">
              <div class="upload-placeholder hidden" id="uploadPlaceholder">
            <% } else { %>
              <img class="cover-preview hidden" id="coverPreview" alt="preview">
              <div class="upload-placeholder" id="uploadPlaceholder">
            <% } %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>Click to replace cover image</span>
              </div>
          </div>
        </div>

        <!-- Video + Audio -->
        <div class="form-row">
          <div class="form-group">
            <label>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Video File <span class="media-hint">(MP4, WebM — max 200MB)</span>
            </label>
            <% if (post.videoFile) { %>
              <div class="current-media-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span>Current: <a href="<%= post.videoFile %>" target="_blank" class="media-link">video file</a></span>
              </div>
            <% } %>
            <div class="media-upload-box" id="videoUploadBox">
              <input type="file" name="videoFile" id="videoFileInput" accept="video/*">
              <div class="media-upload-inner" id="videoPlaceholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span><%= post.videoFile ? 'Upload new video to replace' : 'Upload video' %></span>
              </div>
              <div class="media-selected hidden" id="videoSelected">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span id="videoFileName"></span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              Music / Audio <span class="media-hint">(MP3, WAV — max 50MB)</span>
            </label>
            <% if (post.musicFile) { %>
              <div class="current-media-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                <span>Current: <a href="<%= post.musicFile %>" target="_blank" class="media-link">audio file</a></span>
              </div>
            <% } %>
            <div class="media-upload-box" id="musicUploadBox">
              <input type="file" name="musicFile" id="musicFileInput" accept="audio/*">
              <div class="media-upload-inner" id="musicPlaceholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                <span><%= post.musicFile ? 'Upload new audio to replace' : 'Upload audio' %></span>
              </div>
              <div class="media-selected hidden" id="musicSelected">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                <span id="musicFileName"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Excerpt <span class="charcount" id="excerptCount">0</span> / 200</label>
          <input type="text" name="excerpt" id="excerptInput" value="<%= post.excerpt %>" maxlength="200">
        </div>

        <div class="form-group">
          <label>Content <span class="charcount" id="contentCount">0</span></label>
          <textarea name="content" id="contentInput" rows="12"><%= post.content %></textarea>
        </div>

        <div class="btn-row">
          <a href="/admin/dashboard" class="btn btn-dark">Cancel</a>
          <button type="submit" class="btn btn-primary" id="saveBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </main>

  <div id="toast" class="toast hidden"></div>

  <script>
    const excerptInput = document.getElementById('excerptInput');
    const contentInput = document.getElementById('contentInput');
    document.getElementById('excerptCount').textContent = excerptInput.value.length;
    document.getElementById('contentCount').textContent = contentInput.value.length;
    excerptInput.addEventListener('input', () => document.getElementById('excerptCount').textContent = excerptInput.value.length);
    contentInput.addEventListener('input', () => document.getElementById('contentCount').textContent = contentInput.value.length);

    document.getElementById('uploadArea').addEventListener('click', () => document.getElementById('coverImageInput').click());
    document.getElementById('coverImageInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const preview = document.getElementById('coverPreview');
        preview.src = URL.createObjectURL(file);
        preview.classList.remove('hidden');
        document.getElementById('uploadPlaceholder').classList.add('hidden');
      }
    });

    document.getElementById('videoUploadBox').addEventListener('click', () => document.getElementById('videoFileInput').click());
    document.getElementById('videoFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        document.getElementById('videoPlaceholder').classList.add('hidden');
        document.getElementById('videoSelected').classList.remove('hidden');
        document.getElementById('videoFileName').textContent = file.name;
      }
    });

    document.getElementById('musicUploadBox').addEventListener('click', () => document.getElementById('musicFileInput').click());
    document.getElementById('musicFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        document.getElementById('musicPlaceholder').classList.add('hidden');
        document.getElementById('musicSelected').classList.remove('hidden');
        document.getElementById('musicFileName').textContent = file.name;
      }
    });

    document.getElementById('editForm').addEventListener('submit', function() {
      const btn = document.getElementById('saveBtn');
      btn.disabled = true; btn.innerHTML = 'Saving...';
    });
  </script>
</body>
</html>
