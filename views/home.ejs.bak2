<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WAVZO — Nigerian Music, News & Culture</title>
  <meta name="description" content="Breaking news, trending topics, entertainment & culture.">
  <link rel="canonical" href="https://wavzo.com.ng/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="WAVZO — Nigerian Music, News & Culture">
  <meta property="og:description" content="Breaking news, trending topics, entertainment & culture.">
  <meta property="og:url" content="https://wavzo.com.ng/">
  <meta property="og:site_name" content="WAVZO">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="WAVZO — Nigerian Music, News & Culture">
  <meta name="twitter:description" content="Breaking news, trending topics, entertainment & culture.">
  <link rel="stylesheet" href="/css/style.css">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2046617449524755" crossorigin="anonymous"></script>
  <style>
    .skeleton{background:linear-gradient(90deg,#1a1a1a 25%,#222 50%,#1a1a1a 75%);background-size:200% 100%;animation:shimmer 1.2s infinite;border-radius:8px}
    @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
    .cat-nav{background:#111;display:flex;gap:0;flex-wrap:wrap;padding:0 20px}
    .cat-nav-item{color:#fff;font-size:13px;font-weight:700;padding:14px 18px;cursor:pointer;position:relative;text-decoration:none;display:inline-block}
    .cat-nav-item:hover{background:#1a1a1a}
    .cat-dropdown{padding:0}
    .cat-dropdown>span{display:block;padding:14px 18px;background:#e11}
    .cat-dropdown-menu{display:none;position:absolute;top:100%;left:0;background:#fff;min-width:160px;box-shadow:0 4px 12px rgba(0,0,0,.2);z-index:50;border-radius:0 0 6px 6px;overflow:hidden}
    .cat-dropdown-menu a{display:block;padding:10px 16px;color:#111;font-size:13px;font-weight:600;cursor:pointer}
    .cat-dropdown-menu a:hover{background:#f2efe9;color:#e11}
    .cat-dropdown:hover .cat-dropdown-menu{display:block}
    .search-bar-wrap{background:#111;display:flex;gap:10px;padding:14px 20px;border-top:1px solid #222}
    .search-bar-wrap input{flex:1;max-width:500px;border:none;border-radius:24px;padding:11px 18px;font-size:14px;background:#f2efe9;color:#111}
    .search-bar-wrap input:focus{outline:2px solid #e11}
    .search-bar-wrap button{background:#e11;color:#fff;border:none;border-radius:24px;padding:11px 24px;font-weight:700;font-size:13px;cursor:pointer}
    .search-bar-wrap button:hover{opacity:.88}
    @media (max-width:600px){
      .cat-nav{padding:0 10px}
      .cat-nav-item{padding:12px 12px;font-size:12px}
      .search-bar-wrap{padding:12px 10px}
      .search-bar-wrap input{max-width:none}
    }
  </style>
  <meta name="google-site-verification" content="N_Ld3rdWv_kQf6zgorjRoJk663yRqeXNBFN9JysrIPk" />
</head>
<body>

<% const songList = typeof songs !== 'undefined' ? songs : []; %>
<% const artistList = typeof artists !== 'undefined' ? artists : []; %>
<% const artistMap = {}; artistList.forEach(a => artistMap[a.id] = a); %>

<div class="ticker-bar">
  <span class="ticker-live">LIVE</span>
  <div class="ticker-viewport">
    <div class="ticker-track">
      <% posts.slice(0,6).forEach(p => { %><span><%= p.title %></span><% }) %>
      <% posts.slice(0,6).forEach(p => { %><span><%= p.title %></span><% }) %>
    </div>
  </div>
</div>

<header class="navbar" id="siteNav">
  <div class="logo"><a href="/">WAV<span>ZO</span></a></div>
  <nav>
    <a href="/" class="active">HOME</a>
    <a href="/admin/login">ADMIN</a>
  </nav>
</header>

<div class="cat-nav">
  <div class="cat-nav-item cat-dropdown">
    <span>Categories ▾</span>
    <div class="cat-dropdown-menu">
      <a data-filter="ALL">All Posts</a>
      <a data-filter="NEWS">News</a>
      <a data-filter="ENTERTAINMENT">Entertainment</a>
      <a data-filter="CULTURE">Culture</a>
      <a data-filter="TRENDING">Trending</a>
      <a data-filter="MUSIC">Music</a>
    </div>
  </div>
  <a class="cat-nav-item" data-filter="NEWS">News</a>
  <a class="cat-nav-item" data-filter="ENTERTAINMENT">Entertainment</a>
  <a class="cat-nav-item" data-filter="TRENDING">Trending</a>
</div>

<div class="search-bar-wrap">
  <input type="text" id="postSearch" placeholder="Search WAVZO...">
  <button id="searchBtn">Search</button>
</div>

<% if (posts.length > 0) { const hero = posts[0]; const rest = posts.slice(1,4); %>
<div class="hero-wrap">
  <div>
    <span class="hero-tag">TOP STORY</span>
    <h1 class="hero-title"><%= hero.title %></h1>
    <p class="hero-desc"><%= hero.excerpt %></p>
    <a class="hero-link" href="/post/<%= hero.slug %>">Read full story &rarr;</a>
  </div>
  <div class="sidebar-list">
    <% rest.forEach(p => { %>
      <div class="side-item">
        <div class="side-cat"><%= p.category %></div>
        <a href="/post/<%= p.slug %>" class="side-title"><%= p.title %></a>
      </div>
    <% }) %>
  </div>
</div>
<% } else { %>
<div class="hero-wrap"><p class="muted">No stories published yet. Check back soon.</p></div>
<% } %>

<div class="ad-space">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2046617449524755" data-ad-slot="6071836286" data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>

<div class="latest-header">
  <h2>LATEST STORIES</h2>
  <div class="filters">
    <button class="active" data-filter="ALL">ALL</button>
    <button data-filter="NEWS">NEWS</button>
    <button data-filter="ENTERTAINMENT">ENTERTAINMENT</button>
    <button data-filter="CULTURE">CULTURE</button>
    <button data-filter="TRENDING">TRENDING</button>
    <button data-filter="MUSIC">MUSIC</button>
  </div>
</div>

<% if (songList.length) { %>
<div class="latest-header">
  <h2>🎵 Newly Added Music</h2>
  <a href="/artists" style="font-size:12px;font-weight:700;color:#e11">All Artists &rarr;</a>
</div>
<div class="grid" id="musicGrid" style="margin-bottom:10px">
  <% songList.slice().sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)).slice(0,8).forEach(s => { const artist = artistMap[s.artistId]; %>
    <a class="card" href="/songs/<%= s.slug %>.html" style="text-decoration:none">
      <% if (s.cover) { %><img class="thumb-img" src="<%= s.cover %>"><% } else { %><div class="thumb"></div><% } %>
      <div class="card-body">
        <span class="category"><%= s.type %></span>
        <h3><%= s.title %></h3>
        <p><%= artist ? artist.name : '' %></p>
      </div>
    </a>
  <% }) %>
</div>
<% } %>

<main class="grid" id="postGrid">
  <% posts.forEach(post => { %>
    <div class="card" data-category="<%= post.category %>" data-title="<%= post.title.toLowerCase() %>">
      <% if (post.coverImage) { %>
        <img class="thumb-img" src="<%= post.coverImage %>" loading="lazy" alt="<%= post.title %>">
      <% } else { %>
        <div class="thumb"></div>
      <% } %>
      <div class="card-body">
        <span class="category"><%= post.category %></span>
        <h3><a href="/post/<%= post.slug %>"><%= post.title %></a></h3>
        <p><%= post.excerpt %></p>
        <small>WAVZO Staff &middot; <%= post.date %>
          <% if (post.views) { %>&middot; 👁 <%= post.views.toLocaleString() %><% } %>
          <% if (post.downloads) { %>&middot; ⬇ <%= post.downloads.toLocaleString() %><% } %>
        </small>
      </div>
    </div>
  <% }) %>
</main>
<p id="emptyState" class="hidden">No stories in this category yet.</p>

<div class="bottom-wrap">
  <div></div>
  <div class="ranked-box">
    <h3>RANKED RIGHT NOW</h3>
    <% posts.slice(0,4).forEach((p, i) => { %>
      <div class="ranked-item">
        <div class="ranked-num"><%= String(i+1).padStart(2,'0') %></div>
        <a href="/post/<%= p.slug %>"><%= p.title %></a>
      </div>
    <% }) %>
  </div>
</div>

<div class="newsletter">
  <h2>NEVER MISS A HEADLINE</h2>
  <p>One email a day. The stories everyone's talking about, none of the noise.</p>
  <form method="POST" action="/subscribe" id="subForm">
    <input type="email" name="email" id="subEmail" placeholder="you@email.com" required>
    <button type="submit" id="subBtn">SUBSCRIBE</button>
  </form>
  <% if (typeof subMessage !== 'undefined' && subMessage) { %>
    <p style="margin-top:10px;font-weight:700;"><%= subMessage %></p>
  <% } %>
</div>

<footer>
  <div>&copy; 2026 WAVZO. All rights reserved.</div>
</footer>

<button id="backToTop" aria-label="Back to top">&uarr;</button>

<script>
const grid = document.getElementById('postGrid');
const emptyState = document.getElementById('emptyState');
let currentCategory = 'ALL';

function applyFilters(){
  const q = (document.getElementById('postSearch')?.value || '').trim().toLowerCase();
  let visible = 0;
  document.querySelectorAll('#postGrid .card').forEach(card => {
    const catMatch = currentCategory === 'ALL' || card.dataset.category === currentCategory;
    const searchMatch = !q || card.dataset.title.includes(q);
    const match = catMatch && searchMatch;
    card.style.display = match ? '' : 'none';
    if (match) visible++;
  });
  emptyState.classList.toggle('hidden', visible !== 0);
}

function selectCategory(filter){
  currentCategory = filter;
  document.querySelectorAll('.filters button').forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
  grid.scrollIntoView({behavior:'smooth', block:'start'});
  applyFilters();
}

document.querySelectorAll('[data-filter]').forEach(el => {
  el.addEventListener('click', () => selectCategory(el.dataset.filter));
});

document.getElementById('postSearch')?.addEventListener('input', applyFilters);
document.getElementById('searchBtn')?.addEventListener('click', applyFilters);

const nav = document.getElementById('siteNav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 10);
  document.getElementById('backToTop').classList.toggle('visible', window.scrollY > 500);
});
document.getElementById('backToTop').addEventListener('click', () => window.scrollTo({top:0, behavior:'smooth'}));

document.getElementById('subForm').addEventListener('submit', function(e){
  const email = document.getElementById('subEmail').value.trim();
  const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  if (!valid) { e.preventDefault(); alert('Enter a valid email address'); return; }
  const btn = document.getElementById('subBtn');
  btn.disabled = true;
  btn.textContent = 'SUBSCRIBING...';
});
</script>

<%- include('partials-chat-widget') %>
</body>
</html>
