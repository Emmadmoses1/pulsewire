<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pulsewire</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="ticker-bar">
  <span class="ticker-live">LIVE</span>
  <div class="ticker-viewport"><div class="ticker-track" id="tickerTrack"></div></div>
</div>
<header class="navbar" id="siteNav">
  <div class="logo"><a href="/">PULSE<span>WIRE</span></a></div>
  <nav><a href="/">HOME</a><a href="/artists.html">ARTISTS</a></nav>
</header>

<div class="article-wrap">
  <div class="article-inner">
    <div class="article-breadcrumb"><a href="/">Home</a> / <a href="/artists.html">Artists</a> / <span id="crumbArtist"></span></div>
    <span class="article-cat-tag" id="songType"></span>
    <h1 class="article-title" id="songTitle"></h1>
    <p style="margin-top:-10px;margin-bottom:20px"><a id="artistLink" style="font-weight:700;color:#e11"></a></p>
    <img id="songCover" class="article-cover" src="" alt="">
    <p class="article-body" id="songExcerpt"></p>

    <div class="media-block" id="downloadBlock" style="display:none">
      <div class="media-label">Download</div>
      <a class="download-btn" id="downloadBtn" href="#" target="_blank" rel="noopener">⬇ Download</a>
    </div>

    <div class="media-block" id="videoBlock" style="display:none">
      <div class="media-label">Music Video</div>
      <div id="videoEmbed"></div>
    </div>

    <div class="article-back"><a id="backToArtist" class="back-link">&larr; Back to artist</a></div>
  </div>
</div>

<footer>&copy; Pulsewire</footer>

<script>
const BIN_ID='6aa50e3aac6210605ac3c542';
const BIN_KEY='$2a$10$dsCr1ADyKPDy0pbmzlfCzOnOm9FP8aveuNhIFmktyMa8UvWUoMbUm';
const BIN_URL='https://api.jsonbin.io/v3/b/'+BIN_ID;
const songId='__SONG_ID__';

function youtubeId(url){
  const m=url.match(/(?:youtu\.be\/|v=)([a-zA-Z0-9_-]{11})/);
  return m?m[1]:null;
}

async function init(){
  const res=await fetch(BIN_URL+'/latest',{headers:{'X-Master-Key':BIN_KEY}});
  const data=await res.json();
  const db=data.record||{};
  const song=(db.songs||[]).find(s=>s.id===songId);
  if(!song)return;
  const artist=(db.artists||[]).find(a=>a.id===song.artistId);

  document.getElementById('songType').textContent=song.type;
  document.getElementById('songTitle').textContent=song.title;
  document.getElementById('songExcerpt').textContent=song.excerpt||'';
  if(song.cover)document.getElementById('songCover').src=song.cover;

  if(artist){
    document.getElementById('crumbArtist').textContent=artist.name;
    const link=document.getElementById('artistLink');
    link.textContent='by '+artist.name;
    link.href='/artists/'+artist.slug+'.html';
    document.getElementById('backToArtist').href='/artists/'+artist.slug+'.html';
    document.getElementById('backToArtist').innerHTML='&larr; Back to '+artist.name;
  }

  if(song.downloadUrl){
    document.getElementById('downloadBlock').style.display='block';
    document.getElementById('downloadBtn').href=song.downloadUrl;
  }
  if(song.youtubeUrl){
    const vid=youtubeId(song.youtubeUrl);
    if(vid){
      document.getElementById('videoBlock').style.display='block';
      document.getElementById('videoEmbed').innerHTML=`<iframe width="100%" height="380" style="border-radius:6px;border:none" src="https://www.youtube.com/embed/${vid}" allowfullscreen></iframe>`;
    }
  }

  const track=document.getElementById('tickerTrack');
  [...(db.posts||[]).slice(0,6),...(db.posts||[]).slice(0,6)].forEach(p=>{const s=document.createElement('span');s.textContent=p.title;track.appendChild(s);});
}
init();
window.addEventListener('scroll',()=>{document.getElementById('siteNav').classList.toggle('scrolled',window.scrollY>10);});
</script>
</body>
</html>
