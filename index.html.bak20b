</div></footer>
<button id="top" aria-label="Back to top">&#8593;</button>
<div class="sov" id="sOv" role="dialog" aria-modal="true" aria-label="Search">
  <div class="sbox"><input type="search" id="sIn" placeholder="Search stories, songs, artists..." autocomplete="off"><div id="sOut"></div></div>
  <button class="sx" id="sClose">Close</button>
</div>
<script src="/wz-home.js"></script>
<script>
/*SSR:SIG*/
(function(){
'use strict';
var $=function(i){return document.getElementById(i);};
var Z=window.WZH,D=null,ssr=!!window.__SIG,BIN='https://wavzo-db.dakudinamoses.workers.dev/v3/b/6aa50e3aac6210605ac3c542';
var L={cat:'ALL',next:0,total:0};
/* paste your social page links here. Empty ones are hidden. */
var SOCIAL={Facebook:'',Instagram:'',X:'',YouTube:'',Telegram:'',TikTok:''};

/* theme */
function setTheme(t){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('wz_theme',t);}catch(e){}$('themeBtn').innerHTML=t==='dark'?'&#9728;':'&#9790;';}
$('themeBtn').addEventListener('click',function(){setTheme(document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark');});
setTheme(document.documentElement.getAttribute('data-theme')||'light');
$('burger').addEventListener('click',function(){$('drawer').classList.toggle('on');});

/* hero slider: one timer, swipe, pause on touch/hover */
var H={i:0,n:0,t:null};
function slides(){return document.querySelectorAll('#heroSlides .slide');}
function bars(){return document.querySelectorAll('#heroBars i');}
function go(i){
  var s=slides(),b=bars();if(!s.length)return;
  H.i=(i+s.length)%s.length;
  for(var k=0;k<s.length;k++){s[k].classList.toggle('on',k===H.i);if(b[k]){b[k].className=k<H.i?'done':(k===H.i?'':'');}}
  if(b[H.i]){void b[H.i].offsetWidth;b[H.i].className='cur';}
  clearTimeout(H.t);
  if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&!document.hidden)H.t=setTimeout(function(){go(H.i+1);},6000);
}
function heroInit(){H.n=slides().length;if(H.n)go(0);}
var sl=$('slider'),sx=0;
$('prevBtn').addEventListener('click',function(){go(H.i-1);});
$('nextBtn').addEventListener('click',function(){go(H.i+1);});
sl.addEventListener('mouseenter',function(){clearTimeout(H.t);sl.classList.add('pz');});
sl.addEventListener('mouseleave',function(){sl.classList.remove('pz');go(H.i);});
sl.addEventListener('pointerdown',function(e){sx=e.clientX;});
sl.addEventListener('pointerup',function(e){var d=e.clientX-sx;if(Math.abs(d)>45)go(H.i+(d<0?1:-1));});
document.addEventListener('visibilitychange',function(){if(document.hidden)clearTimeout(H.t);else go(H.i);});

/* data */
function norm(j){return {posts:(j.posts||[]).slice().reverse(),songs:j.songs||[],artists:j.artists||[]};}
function cget(){try{var c=JSON.parse(localStorage.getItem('wz_v5')||'null');if(c&&Date.now()-c.ts<300000)return c;}catch(e){}return null;}
function cset(d){try{localStorage.setItem('wz_v5',JSON.stringify({posts:d.posts,songs:d.songs,artists:d.artists,ts:Date.now()}));}catch(e){}}
async function load(){
  var urls=['/data/home.json','/data/db.json'];
  for(var i=0;i<urls.length;i++){try{var r=await fetch(urls[i]);if(!r.ok)continue;var j=await r.json();if(j&&Array.isArray(j.posts))return norm(j);}catch(e){}}
  var r2=await fetch(BIN+'/latest',{headers:{'X-Master-Key':'public'}});var d=await r2.json();return norm(d.record||{});
}

/* painting */
function showMore(){var m=$('more');m.hidden=!(L.next<L.total);}
function drawLatest(reset){
  var r=Z.latest(D.posts,L.cat,reset?0:L.next,Z.PER_PAGE);
  if(reset)$('grid').innerHTML=r.html;else $('grid').insertAdjacentHTML('beforeend',r.html);
  L.next=reset?r.next:r.next;L.total=r.total;$('empty').hidden=r.total>0;showMore();
}
function paint(){
  var o=Z.build(D);
  $('tickerTrack').innerHTML=o.ticker;$('heroBars').innerHTML=o.bars;$('heroSlides').innerHTML=o.hero;$('trendList').innerHTML=o.trending;
  $('musicWrap').innerHTML=o.music;$('artistWrap').innerHTML=o.artists;$('sections').innerHTML=o.sections;$('chips').innerHTML=o.chips;
  L.cat='ALL';drawLatest(true);heroInit();
}
$('chips').addEventListener('click',function(e){
  var c=e.target.closest('.chip');if(!c||!D)return;
  e.preventDefault();L.cat=c.getAttribute('data-cat');
  [].forEach.call($('chips').children,function(x){x.classList.toggle('on',x===c);});
  drawLatest(true);
});
$('more').addEventListener('click',function(){if(D)drawLatest(false);});

/* search */
function openS(q){$('sOv').classList.add('on');var i=$('sIn');i.value=q||'';i.focus();doS();document.body.style.overflow='hidden';}
function closeS(){$('sOv').classList.remove('on');document.body.style.overflow='';}
function doS(){
  var q=$('sIn').value.trim().toLowerCase(),out=$('sOut');
  if(!D){out.innerHTML='<p class="empty">Loading...</p>';return;}
  if(q.length<2){out.innerHTML='<p class="empty">Type at least 2 letters</p>';return;}
  var E=Z.esc,h='';
  D.artists.filter(function(a){return a.slug&&String(a.name||'').toLowerCase().indexOf(q)>-1;}).slice(0,3).forEach(function(a){h+='<a class="sr-i" href="/artists/'+E(a.slug)+'.html"><em>&#127908;</em><span><b>'+E(a.name)+'</b><small>Artist</small></span></a>';});
  D.songs.filter(function(s){return s.slug&&String(s.title||'').toLowerCase().indexOf(q)>-1;}).slice(0,4).forEach(function(s){h+='<a class="sr-i" href="/songs/'+E(s.slug)+'.html"><em>&#127925;</em><span><b>'+E(s.title)+'</b><small>Song</small></span></a>';});
  D.posts.filter(function(p){return String(p.title||'').toLowerCase().indexOf(q)>-1||String(p.excerpt||'').toLowerCase().indexOf(q)>-1;}).slice(0,10).forEach(function(p){
    var im=Z.IMG(p.coverImage,120,120);
    h+='<a class="sr-i" href="/posts/'+E(p.slug)+'.html">'+(im?'<img src="'+E(im)+'" width="52" height="52" alt="" loading="lazy">':'<em>&#128240;</em>')+'<span><b>'+E(p.title)+'</b><small>'+E(p.category||'')+' &middot; '+E(p.date||'')+'</small></span></a>';});
  out.innerHTML=h||'<p class="empty">Nothing found for "'+E(q)+'"</p>';
}
$('searchBtn').addEventListener('click',function(){openS('');});
$('sIn').addEventListener('input',doS);
$('sClose').addEventListener('click',closeS);
$('sOv').addEventListener('click',function(e){if(e.target===$('sOv'))closeS();});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape')closeS();
  if((e.key==='/'&&!/INPUT|TEXTAREA/.test((document.activeElement||{}).tagName))||((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k')){e.preventDefault();openS('');}
});

/* page chrome */
var tick=false;
window.addEventListener('scroll',function(){if(tick)return;tick=true;requestAnimationFrame(function(){$('hdr').classList.toggle('sc',scrollY>8);$('top').classList.toggle('on',scrollY>700);tick=false;});},{passive:true});
$('top').addEventListener('click',function(){scrollTo({top:0,behavior:'smooth'});});
$('shareBtn').addEventListener('click',function(e){e.preventDefault();var d={title:'WAVZO',text:'Nigerian music, news and culture',url:'https://wavzo.com.ng/'};if(navigator.share)navigator.share(d).catch(function(){});else if(navigator.clipboard){navigator.clipboard.writeText(d.url);alert('Link copied');}});
var soc=$('soc');Object.keys(SOCIAL).forEach(function(k){if(/^https:\/\//.test(SOCIAL[k]))soc.insertAdjacentHTML('beforeend','<a href="'+SOCIAL[k]+'" target="_blank" rel="noopener">'+k+'</a>');});
soc.insertAdjacentHTML('beforeend','<a href="https://wa.me/2348124992371" target="_blank" rel="noopener">WhatsApp</a>');

/* install as app */
var dp=null;
window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();dp=e;$('installBtn').hidden=false;});
$('installBtn').addEventListener('click',function(){if(!dp)return;dp.prompt();dp.userChoice.then(function(){dp=null;$('installBtn').hidden=true;});});
if('serviceWorker' in navigator)window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});

/* newsletter */
$('subForm').addEventListener('submit',async function(e){
  e.preventDefault();
  var btn=this.querySelector('button'),inp=$('subEmail'),msg=$('subMsg');
  if(!msg){msg=document.createElement('div');msg.id='subMsg';msg.style.cssText='margin-top:14px;font-size:13px;color:rgba(255,255,255,.75);min-height:18px';this.insertAdjacentElement('afterend',msg);}
  btn.disabled=true;btn.textContent='Subscribing...';
  try{
    var r=await fetch('https://wavzo-db.dakudinamoses.workers.dev/subscribe',{method:'POST',headers:{'Content-Type':'text/plain'},body:JSON.stringify({email:inp.value.trim(),src:'home'})});
    var d=await r.json().catch(function(){return {};});
    if(r.ok&&d.ok){btn.textContent='Subscribed \u2713';inp.value='';msg.style.color='#7ddc9d';msg.textContent=d.message||'Thanks for subscribing!';}
    else{btn.textContent='Subscribe';msg.style.color='#ff9b9b';msg.textContent=d.message||'Could not subscribe. Please try again.';}
  }catch(err){btn.textContent='Subscribe';msg.style.color='#ff9b9b';msg.textContent='No connection. Please try again.';}
  btn.disabled=false;setTimeout(function(){btn.textContent='Subscribe';},4000);
});

/* start */
if(ssr)heroInit();
(async function(){
  var c=!ssr&&cget();
  if(c){D=c;paint();}
  try{
    var d=await load();D=d;cset(d);
    if(!ssr||!window.__SIG||Z.sig(d.posts)!==window.__SIG||!slides().length){paint();}
    else{var r=Z.latest(d.posts,'ALL',0,Z.PER_PAGE);L.next=r.next;L.total=r.total;showMore();}
  }catch(e){
    if(!D&&!ssr)$('grid').innerHTML='<p class="empty">Could not load stories. Please refresh.</p>';
  }
  var q=new URLSearchParams(location.search).get('q');if(q)openS(q);
})();
})();
</script>
<script>
/* WZ-TRACK */
(function(){
  var API='https://wavzo-db.dakudinamoses.workers.dev/track';
  var host=location.hostname;
  var live=(host==='wavzo.com.ng'||host==='www.wavzo.com.ng');
  var owner=false;try{owner=!!localStorage.getItem('wz_key');}catch(e){}
  function send(ev,kind,key){
    try{
      if(!live||owner||!key||!/^[\w.\-:~%]{1,120}$/.test(key))return;
      var body=JSON.stringify({ev:ev,kind:kind,key:key,ref:document.referrer||''});
      if(navigator.sendBeacon){navigator.sendBeacon(API,new Blob([body],{type:'text/plain'}));return;}
      fetch(API,{method:'POST',body:body,keepalive:true,headers:{'Content-Type':'text/plain'}});
    }catch(e){}
  }
  window.WZ={track:send};
  function pathSlug(dir){
    var m=location.pathname.match(new RegExp('^/'+dir+'/([^/]+?)(?:\\.html)?$'));
    if(!m)return '';
    try{return decodeURIComponent(m[1]);}catch(e){return m[1];}
  }
  function wrap(name,fn){
    var old=window[name];
    if(typeof old!=='function')return;
    window[name]=function(){try{fn.apply(null,arguments);}catch(e){} return old.apply(this,arguments);};
  }
  var path=location.pathname,kind='',key='';
  if(pathSlug('posts')){kind='post';key=pathSlug('posts');}
  else if(pathSlug('songs')){kind='song';key=pathSlug('songs');}
  else if(pathSlug('artists')){kind='artist';key=pathSlug('artists');}
  else if(path==='/'||path==='/index.html'){kind='page';key='home';}
  else if(path==='/artists.html'){kind='page';key='artists';}
  if(!kind)return;
  send('view',kind,key);

  // first play of any audio/video on the page
  var played={};
  document.addEventListener('play',function(e){
    var t=e.target;if(!t||!t.tagName)return;
    var id=(t.currentSrc||t.src||t.tagName);
    if(played[id])return;played[id]=1;
    send('play',kind,key);
  },true);

  if(kind==='post'){
    wrap('trackDownload',function(){send('download','post',key);});
    wrap('sharePost',function(){send('share','post',key);});
  }
  if(kind==='song'){
    wrap('downloadMp3',function(){send('download','song',key);});
    // a tap inside the YouTube player moves focus into the iframe
    window.addEventListener('blur',function(){
      setTimeout(function(){
        var a=document.activeElement;
        if(a&&a.tagName==='IFRAME'&&!a._wz){a._wz=1;send('yt','song',key);}
      },50);
    });
  }
  // clicks on outbound links (YouTube, streaming, social)
  document.addEventListener('click',function(e){
    var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;
    if(!a)return;
    var h=a.getAttribute('href')||'';
    if(!/^https?:\/\//i.test(h)||h.indexOf(host)>-1)return;
    send(/youtube\.com|youtu\.be/i.test(h)?'yt':'click',kind,key);
  },true);
  if(kind==='artist'){
    document.addEventListener('click',function(e){
      var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;
      if(a&&/\/songs\//.test(a.getAttribute('href')||''))send('click','artist',key);
    },true);
  }
})();
</script>
<script>
/* PROMO-BANNER */
(function(){
  var WA_NUMBER='2348124992371';
  if(!WA_NUMBER||WA_NUMBER.indexOf('REPLACE')===0)return;
  var owner=false;try{owner=!!localStorage.getItem('wz_key');}catch(e){}
  if(owner)return;
  var HIDE_KEY='wz_promo_hidden_until';
  try{
    var until=+(localStorage.getItem(HIDE_KEY)||0);
    if(until&&Date.now()<until)return;
  }catch(e){}

  var css=document.createElement('style');
  css.textContent=
    '#wzPromo{position:fixed;left:50%;bottom:-100px;transform:translateX(-50%);z-index:400;'+
    'background:#0a0a0a;color:#fff;padding:12px 16px;border-radius:14px;box-shadow:0 6px 24px rgba(0,0,0,.35);'+
    'display:flex;align-items:center;gap:10px;max-width:92vw;transition:bottom .5s ease;font-family:inherit}'+
    '#wzPromo.show{bottom:16px}'+
    '#wzPromo a{color:#fff;text-decoration:none;font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px}'+
    '#wzPromo .x{cursor:pointer;color:#888;font-size:16px;line-height:1;padding:2px 4px;flex-shrink:0}'+
    '@media(max-width:420px){#wzPromo a{font-size:12px}}';
  document.head.appendChild(css);

  var el=document.createElement('div');
  el.id='wzPromo';
  var text=encodeURIComponent("Hi WAVZO, I'd like to upload my song.");
  el.innerHTML='<a href="https://wa.me/'+WA_NUMBER+'?text='+text+'" target="_blank" rel="noopener">🎵 Upload your song on WAVZO — chat us on WhatsApp</a>'+
    '<span class="x" id="wzPromoClose">×</span>';
  document.body.appendChild(el);

  setTimeout(function(){el.classList.add('show');},2500);
  document.getElementById('wzPromoClose').addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();
    el.classList.remove('show');
    try{localStorage.setItem(HIDE_KEY,String(Date.now()+24*3600000));}catch(err){}
    setTimeout(function(){el.remove();},600);
  });
})();
</script>
</body>
</html>
