<!--SSR:preload-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://wsrv.nl">
<link rel="preconnect" href="https://res.cloudinary.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"></noscript>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2046617449524755" crossorigin="anonymous"></script>
<style>
:root{--bg:#f4f4f8;--card:#fff;--text:#0b0b12;--muted:#6a6a78;--line:#e6e6ee;--brand:#e5202f;--brand2:#ff7a45;--shadow:0 22px 44px -26px rgba(12,12,40,.4);--r:18px;--glass:rgba(255,255,255,.82)}
[data-theme=dark]{--bg:#07070b;--card:#101018;--text:#f3f3f7;--muted:#9696a6;--line:#22222d;--shadow:0 26px 50px -30px rgba(0,0,0,.95);--glass:rgba(10,10,16,.8)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;line-height:1.5}
a{color:inherit;text-decoration:none}img{max-width:100%;display:block}button{font-family:inherit}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;z-index:999;background:#fff;color:#000;padding:10px 14px;border-radius:8px}.skip:focus{left:10px}
.wrap{max-width:1240px;margin:0 auto;padding:0 18px}
.meta{font-size:12px;color:var(--muted)}
/* ticker */
.ticker{background:#0a0a0f;color:#fff;display:flex;align-items:center;font-size:12px;height:36px;overflow:hidden}
.live{background:var(--brand);font-weight:800;letter-spacing:2px;font-size:10px;padding:5px 12px;margin:0 14px;border-radius:4px;flex-shrink:0;display:flex;align-items:center;gap:6px}
.live::before{content:'';width:6px;height:6px;border-radius:50%;background:#fff;animation:pulse 1.4s infinite}
@keyframes pulse{50%{opacity:.25}}
.tk-view{flex:1;overflow:hidden;min-width:0;white-space:nowrap}
.tk-track{display:inline-block;animation:tick 70s linear infinite}
.tk-track a{display:inline-block;margin-right:54px;opacity:.9}.tk-track a::before{content:'\25CF';color:var(--brand);margin-right:54px;font-size:8px;vertical-align:middle}
.ticker:hover .tk-track{animation-play-state:paused}
@keyframes tick{to{transform:translateX(-50%)}}
/* header */
.hdr{position:sticky;top:0;z-index:300;background:var(--glass);-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%);border-bottom:1px solid var(--line);transition:box-shadow .2s}
.hdr.sc{box-shadow:0 10px 30px -18px rgba(0,0,0,.5)}
.hdr-in{display:flex;align-items:center;justify-content:space-between;height:62px;gap:12px}
.logo{font-size:27px;font-weight:900;letter-spacing:-1.6px}
.logo span{background:linear-gradient(135deg,var(--brand),var(--brand2));-webkit-background-clip:text;background-clip:text;color:transparent}
.nav{display:flex;gap:2px}
.nav a{font-size:13px;font-weight:600;color:var(--muted);padding:8px 13px;border-radius:999px;transition:.15s}
.nav a:hover{color:var(--text);background:rgba(127,127,150,.12)}
.acts{display:flex;align-items:center;gap:8px}
.ibtn{height:40px;min-width:40px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--text);font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.15s}
.ibtn:hover{border-color:var(--brand);color:var(--brand)}
.ibtn.pri{background:linear-gradient(135deg,var(--brand),var(--brand2));border-color:transparent;color:#fff}
.ibtn[hidden]{display:none}
.burger{display:none}
@media(max-width:860px){.nav{display:none}.burger{display:inline-flex}.srch-t{display:none}.logo{font-size:24px}}
.drawer{display:none;border-bottom:1px solid var(--line);background:var(--card)}
.drawer.on{display:block}
.drawer a{display:block;padding:14px 20px;font-weight:700;border-top:1px solid var(--line);font-size:14px}
/* section chips */
.chips{display:flex;gap:8px;overflow-x:auto;padding:14px 0 4px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;padding:8px 16px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:13px;font-weight:600;color:var(--muted);transition:.15s;cursor:pointer}
.chip:hover{color:var(--text);border-color:var(--text)}
.chip.on{background:var(--text);color:var(--bg);border-color:var(--text)}
/* hero */
.hero{display:grid;gap:18px;grid-template-columns:1fr;margin-top:14px}
@media(min-width:1000px){.hero{grid-template-columns:1.8fr 1fr}}
.slider{position:relative;border-radius:var(--r);overflow:hidden;background:#000;aspect-ratio:16/11;box-shadow:var(--shadow);touch-action:pan-y;min-height:260px}
@media(min-width:700px){.slider{aspect-ratio:16/9}}
.slide{position:absolute;inset:0;opacity:0;transition:opacity .7s;pointer-events:none}
.slide.on{opacity:1;pointer-events:auto}
.slide-link{position:absolute;inset:0;z-index:2}
.slide-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.02);transition:transform 7s ease-out}
.slide.on .slide-img{transform:scale(1.08)}
.ph{display:flex;align-items:center;justify-content:center;font-size:42px;background:linear-gradient(135deg,#15151d,#2b0d12);color:#fff}
.slide-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.88),rgba(0,0,0,.25) 55%,rgba(0,0,0,.05))}
.slide-body{position:absolute;left:0;right:0;bottom:0;padding:clamp(16px,3vw,34px);color:#fff;z-index:1;max-width:760px}
.pill{display:inline-block;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;padding:5px 11px;border-radius:999px;margin-bottom:10px}
.slide-body h2{font-size:clamp(20px,3.4vw,36px);font-weight:900;line-height:1.14;letter-spacing:-.6px;margin-bottom:8px;text-wrap:balance}
.slide-body p{font-size:14px;color:rgba(255,255,255,.78);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px;max-width:560px}
@media(max-width:700px){.slide-body p{display:none}}
.slide-body .meta{color:rgba(255,255,255,.6)}
.bars{position:absolute;top:12px;left:14px;right:14px;z-index:4;display:flex;gap:6px}
.bars i{flex:1;height:3px;border-radius:3px;background:rgba(255,255,255,.32);overflow:hidden}
.bars b{display:block;height:100%;width:0;background:#fff}
.bars i.done b{width:100%}
.bars i.cur b{animation:fill 6s linear forwards}
.slider.pz .bars i.cur b{animation-play-state:paused}
@keyframes fill{to{width:100%}}
.arr{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#fff;font-size:20px;cursor:pointer;display:none}
.arr:hover{background:rgba(0,0,0,.55)}.arr.p{left:14px}.arr.n{right:14px}
@media(min-width:900px){.arr{display:block}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:8px 16px 10px;box-shadow:var(--shadow)}
.panel-hd{font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;padding:12px 0 6px;display:flex;align-items:center;gap:8px}
.rank{display:flex;gap:12px;align-items:center;padding:11px 0;border-top:1px solid var(--line)}
.rank b{font-size:26px;font-weight:900;width:26px;text-align:center;background:linear-gradient(135deg,var(--brand),var(--brand2));-webkit-background-clip:text;background-clip:text;color:transparent;flex-shrink:0}
.rt{flex:1;min-width:0;font-size:14px;font-weight:700;line-height:1.3;display:block}
.rt small{display:block;font-size:11px;font-weight:500;color:var(--muted);margin-top:3px}
.rank-img{width:64px;height:48px;border-radius:10px;object-fit:cover;flex-shrink:0}
.rank:hover .rt{color:var(--brand)}
/* quick strip */
.quick{display:grid;gap:12px;margin-top:18px}
@media(min-width:700px){.quick{grid-template-columns:1fr 1fr}}
.qk{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:var(--r);color:#fff;position:relative;overflow:hidden;transition:transform .2s}
.qk:hover{transform:translateY(-2px)}
.qk.sc{background:linear-gradient(120deg,#0f7a3b,#16a34a)}
.qk.up{background:linear-gradient(120deg,#b4161f,#ff7a45)}
.qk i{font-style:normal;font-size:28px}
.qk b{display:block;font-size:15px;font-weight:800}.qk span{font-size:12px;opacity:.85}
.qk::after{content:'\2192';margin-left:auto;font-size:20px;font-weight:800}
/* blocks */
.blk{margin-top:34px}
.blk-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.blk-hd h2{font-size:20px;font-weight:900;letter-spacing:-.4px;display:flex;align-items:center;gap:10px}
.blk-hd h2 i{font-style:normal;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,rgba(229,32,47,.16),rgba(255,122,69,.16));display:inline-flex;align-items:center;justify-content:center;font-size:17px}
.blk-hd a{font-size:13px;font-weight:700;color:var(--brand)}
.rail{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x proximity;padding:2px 2px 14px;scrollbar-width:none}
.rail::-webkit-scrollbar{display:none}
.song{flex:0 0 164px;scroll-snap-align:start;display:block}
.song img,.song-ph{width:164px;height:164px;border-radius:16px;object-fit:cover;box-shadow:var(--shadow);transition:transform .25s;background:#222}
.song-ph{display:flex;align-items:center;justify-content:center;font-size:42px;background:linear-gradient(135deg,#15151d,#e5202f)}
.song:hover img{transform:translateY(-4px) scale(1.02)}
.song b{display:block;font-size:13px;font-weight:800;margin-top:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.song small{font-size:12px;color:var(--muted)}
.rail.av{gap:18px}
.artist{flex:0 0 92px;text-align:center;scroll-snap-align:start}
.ring{display:block;width:84px;height:84px;margin:0 auto 8px;border-radius:50%;padding:3px;background:linear-gradient(135deg,var(--brand),var(--brand2));transition:transform .25s}
.ring img,.ring em{width:100%;height:100%;border-radius:50%;object-fit:cover;border:3px solid var(--bg);background:#222;display:flex;align-items:center;justify-content:center;font-style:normal}
.artist:hover .ring{transform:scale(1.07)}
.artist b{font-size:12px;font-weight:700;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* category sections */
.sec{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:860px){.sec{grid-template-columns:1.25fr 1fr}}
.big{position:relative;display:block;border-radius:var(--r);overflow:hidden;aspect-ratio:16/10;background:#000;box-shadow:var(--shadow)}
.big-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s}
.big:hover .big-img{transform:scale(1.05)}
.big-b{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.4vw,24px);color:#fff;z-index:1}
.big-b h3{font-size:clamp(17px,2.2vw,24px);font-weight:800;line-height:1.2;text-wrap:balance}
.stack{display:flex;flex-direction:column;gap:10px}
.row{display:flex;gap:14px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:10px;transition:.2s;flex:1}
.row:hover{border-color:var(--brand);transform:translateX(3px)}
.row-img{width:104px;height:76px;border-radius:12px;object-fit:cover;flex-shrink:0}
.row .rt{font-size:14px}
/* latest */
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s,border-color .25s}
.card:hover{transform:translateY(-5px);box-shadow:var(--shadow);border-color:rgba(229,32,47,.5)}
.card-img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#222}
.card-b{padding:14px 16px 16px;display:flex;flex-direction:column;gap:7px;flex:1}
.cat{font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--brand)}
.c-news{color:#2563eb}.c-entertainment{color:#db2777}.c-sports{color:#16a34a}.c-trending{color:#d97706}.c-gospel{color:#7c3aed}.c-culture{color:#0d9488}
.card h3{font-size:16px;font-weight:800;line-height:1.3;letter-spacing:-.2px}
.card p{font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card .meta{margin-top:auto;padding-top:8px}
.more{display:block;margin:26px auto 0;min-width:220px}
.empty{padding:28px;text-align:center;color:var(--muted);font-size:14px}
.adbox{margin:26px 0 0;min-height:0}
/* newsletter + footer */
.news{margin-top:48px;background:radial-gradient(700px 300px at 85% -20%,rgba(255,122,69,.35),transparent 60%),linear-gradient(135deg,#120a0c,#2a0b10);color:#fff;border-radius:26px;padding:clamp(28px,5vw,56px);text-align:center}
.news .pill{margin-bottom:14px}
.news h2{font-size:clamp(24px,4vw,34px);font-weight:900;letter-spacing:-.8px;margin-bottom:8px}
.news p{color:rgba(255,255,255,.7);font-size:14px;margin:0 auto 22px;max-width:460px}
.news form{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;max-width:520px;margin:0 auto}
.news input{flex:1;min-width:210px;padding:15px 20px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;font-size:14px;outline:none}
.news input::placeholder{color:rgba(255,255,255,.5)}
.news input:focus{border-color:var(--brand2)}
.news button{padding:15px 28px;border:0;border-radius:999px;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;font-weight:800;font-size:13px;letter-spacing:.8px;text-transform:uppercase;cursor:pointer}
.soc{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:20px}
.soc a{padding:9px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.2);font-size:12px;font-weight:700;color:#fff}
.soc a:hover{background:rgba(255,255,255,.12)}
.foot{margin-top:48px;border-top:1px solid var(--line);padding:40px 0 28px}
.fg{display:grid;gap:30px;grid-template-columns:1fr}
@media(min-width:760px){.fg{grid-template-columns:1.6fr 1fr 1fr 1fr}}
.fg p{font-size:13px;color:var(--muted);max-width:300px;margin-top:10px}
.fg h4{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.fg a.l{display:block;font-size:14px;font-weight:500;padding:5px 0;color:var(--text)}
.fg a.l:hover{color:var(--brand)}
.fb{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:30px;padding-top:20px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}
#top{position:fixed;right:18px;bottom:18px;width:44px;height:44px;border-radius:50%;border:0;background:var(--text);color:var(--bg);font-size:18px;cursor:pointer;display:none;z-index:250;box-shadow:var(--shadow)}
#top.on{display:block}
/* search */
.sov{position:fixed;inset:0;z-index:600;background:rgba(5,5,10,.7);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);display:none;padding:max(14px,env(safe-area-inset-top)) 14px 14px}
.sov.on{display:block}
.sbox{max-width:680px;margin:6vh auto 0;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);overflow:hidden}
.sbox input{width:100%;padding:20px 22px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--text);font-size:17px;outline:none}
#sOut{max-height:62vh;overflow-y:auto;padding:8px}
.sr-i{display:flex;gap:12px;align-items:center;padding:10px;border-radius:12px}
.sr-i:hover{background:rgba(127,127,150,.12)}
.sr-i img,.sr-i em{width:52px;height:52px;border-radius:10px;object-fit:cover;flex-shrink:0;background:#222;font-style:normal;display:flex;align-items:center;justify-content:center}
.sr-i b{font-size:14px;display:block;line-height:1.3}.sr-i small{color:var(--muted);font-size:12px}
.sx{display:block;margin:10px auto 0;color:#fff;background:transparent;border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:9px 22px;cursor:pointer;font-size:13px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="ticker" role="marquee" aria-label="Latest headlines"><span class="live">LIVE</span><div class="tk-view"><div class="tk-track" id="tickerTrack"><!--SSR:ticker--></div></div></div>
<header class="hdr" id="hdr"><div class="wrap hdr-in">
  <a class="logo" href="/" aria-label="WAVZO home">WAV<span>ZO</span></a>
  <nav class="nav" aria-label="Main">
    <a href="/category/news">News</a><a href="/category/music">Music</a><a href="/category/entertainment">Entertainment</a><a href="/category/trending">Trending</a><a href="/category/sports">Sports</a><a href="/artists.html">Artists</a><a href="/livescores.html">Live scores</a>
  </nav>
  <div class="acts">
    <button class="ibtn pri" id="installBtn" hidden>Install app</button>
    <button class="ibtn" id="searchBtn" aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><span class="srch-t">Search</span></button>
    <button class="ibtn" id="themeBtn" aria-label="Switch light or dark mode">&#9790;</button>
    <button class="ibtn burger" id="burger" aria-label="Menu">&#9776;</button>
  </div>
</div></header>
<div class="drawer" id="drawer">
  <a href="/">Home</a><a href="/category/news">News</a><a href="/category/music">Music</a><a href="/category/entertainment">Entertainment</a><a href="/category/trending">Trending</a><a href="/category/sports">Sports</a><a href="/category/gospel">Gospel</a><a href="/artists.html">Artists</a><a href="/livescores.html">Live scores</a>
</div>
<main id="main" class="wrap">
  <h1 class="sr">WAVZO: Nigerian music, breaking news, entertainment and gist</h1>
  <section class="hero" aria-label="Top stories">
    <div class="slider" id="slider">
      <div class="bars" id="heroBars"><!--SSR:bars--></div>
      <div id="heroSlides"><!--SSR:hero--></div>
      <button class="arr p" id="prevBtn" aria-label="Previous story">&#8249;</button><button class="arr n" id="nextBtn" aria-label="Next story">&#8250;</button>
    </div>
    <aside class="panel"><div class="panel-hd">&#128293; Trending now</div><div id="trendList"><!--SSR:trending--></div></aside>
  </section>
  <div class="quick">
    <a class="qk sc" href="/livescores.html"><i>&#9917;</i><div><b>Live scores</b><span>Follow every match as it happens</span></div></a>
    <a class="qk up" href="https://wa.me/2348124992371?text=Hi%20WAVZO%2C%20I'd%20like%20to%20upload%20my%20song." target="_blank" rel="noopener"><i>&#127911;</i><div><b>Upload your song</b><span>Get featured on WAVZO. Chat with us on WhatsApp</span></div></a>
  </div>
  <div id="musicWrap"><!--SSR:music--></div>
  <div id="artistWrap"><!--SSR:artists--></div>
  <div class="adbox"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2046617449524755" data-ad-slot="6071836286" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <div id="sections"><!--SSR:sections--></div>
  <section class="blk" id="latest">
    <div class="blk-hd"><h2><i>&#9889;</i> Latest stories</h2></div>
    <nav class="chips" id="chips" aria-label="Filter stories"><!--SSR:chips--></nav>
    <div class="grid" id="grid"><!--SSR:latest--></div>
    <p class="empty" id="empty" hidden>No stories found.</p>
    <button class="ibtn more" id="more" hidden>Load more stories</button>
  </section>
  <section class="news" aria-label="Newsletter">
    <span class="pill">Newsletter</span>
    <h2>Never miss a headline</h2>
    <p>Get an email whenever we publish new music and breaking news.</p>
    <form id="subForm"><label class="sr" for="subEmail">Email address</label><input type="email" id="subEmail" placeholder="Your email address" required autocomplete="email"><button type="submit">Subscribe</button></form>
    <div class="soc" id="soc"></div>
  </section>
</main>
<footer class="foot"><div class="wrap">
  <div class="fg">
    <div><a class="logo" href="/">WAV<span>ZO</span></a><p>Nigeria's home for new music, breaking news, entertainment and culture, all in one place.</p></div>
    <div><h4>Sections</h4><a class="l" href="/category/news">News</a><a class="l" href="/category/music">Music</a><a class="l" href="/category/entertainment">Entertainment</a><a class="l" href="/category/trending">Trending</a><a class="l" href="/category/sports">Sports</a><a class="l" href="/category/gospel">Gospel</a></div>
    <div><h4>Explore</h4><a class="l" href="/artists.html">Artists</a><a class="l" href="/livescores.html">Live scores</a><a class="l" href="/about.html">About</a><a class="l" href="/contact.html">Contact</a></div>
    <div><h4>Legal</h4><a class="l" href="/dmca.html">DMCA</a><a class="l" href="/privacy-policy.html">Privacy policy</a><a class="l" href="/terms.html">Terms</a><a class="l" href="#" id="shareBtn">Share WAVZO</a></div>
  </div>
